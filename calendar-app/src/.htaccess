<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Ensure the RewriteBase points cleanly to your subfolder
  RewriteBase /calendar/

  # CRITICAL: If the file or directory exists physically, serve it as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Only redirect to index.html if the request is NOT for a real asset file
  RewriteRule ^ index.html [L]
</IfModule>